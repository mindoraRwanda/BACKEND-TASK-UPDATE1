generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("MOOD_DATABASE_URL")
}

// mood_entries is a TimescaleDB hypertable partitioned by recorded_at
// Run after migration: SELECT create_hypertable('mood_entries', 'recorded_at');
model MoodEntry {
  id                   String   @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  moodScore            Int      @map("mood_score")
  emotions             String[] @default([])
  sleepHours           Float?   @map("sleep_hours")
  stressLevel          Int?     @map("stress_level")
  energyLevel          Int?     @map("energy_level")
  journalNoteEncrypted String?  @map("journal_note_encrypted")
  triggers             String[] @default([])
  recordedAt           DateTime @default(now()) @map("recorded_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@id([id, recordedAt])
  @@index([userId, recordedAt])
  @@map("mood_entries")
}

model ScreeningResult {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  instrumentId     String   @map("instrument_id")
  scoringVersion   String   @map("scoring_version")
  answersEncrypted String   @map("answers_encrypted") @db.Text
  rawScore         Int      @map("raw_score")
  displayScore     String   @map("display_score")
  maxScore         String   @map("max_score")
  severity         String
  label            String
  interpretation   String   @db.Text
  extras           Json?
  completedAt      DateTime @default(now()) @map("completed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, completedAt])
  @@map("screening_results")
}
